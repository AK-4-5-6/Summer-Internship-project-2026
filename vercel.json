{
  "routes": [
    {
      "src": "/CSS%20Files/(.*)",
      "dest": "/CSS Files/$1"
    },
    {
      "src": "/JS%20Files/(.*)",
      "dest": "/JS Files/$1"
    },
    {
      "src": "/Project%20Images/(.*)",
      "dest": "/Project Images/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
